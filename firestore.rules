rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // রুটিন ও সিলেবাস: সবাই পড়তে পারবে, শুধু অ্যাডমিন লিখতে পারবে
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL';
    }
    match /routines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // অ্যাপ এটা পড়ে বোঝে লগইন করা ব্যক্তি অ্যাডমিন কিনা
    match /admin/{id} {
      allow read: if isAdmin();
    }
    match /syllabus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
