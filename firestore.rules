rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // রুটিন ও সিলেবাস: সবাই পড়তে পারবে, শুধু অ্যাডমিন লিখতে পারবে
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'shohoggonitacademy8159@gmail.com';
    }
    match /routines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /syllabus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
