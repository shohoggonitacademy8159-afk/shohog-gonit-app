rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // অ্যাডমিন: Firebase কনসোলে বসানোর সময় ADMIN_EMAIL জায়গায় আসল ইমেইল দিন
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL';
    }
    match /routines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin/{id} {
      allow read: if isAdmin();
    }
    match /syllabus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // শিক্ষার্থীর পরীক্ষার ফলাফল: শিক্ষার্থী শুধু নতুন জমা দিতে পারে, সবাই মেধাতালিকা দেখতে পারে, মুছতে পারে শুধু অ্যাডমিন
    match /results/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['course','date','kind','examKey','name','roll','score','total','late','at','device'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.roll is string && request.resource.data.roll.size() <= 20
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.total <= 100;
    }
    // শিক্ষার্থীদের সমস্যা রিপোর্ট: শিক্ষার্থী শুধু নতুন পাঠাতে পারে, দেখা/বদলানো/মোছা শুধু অ্যাডমিন
    // ডিভাইস থেকে আপলোড করা PDF (টুকরো করে রাখা); সবাই পড়বে, শুধু অ্যাডমিন লিখবে
    match /pdfs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['type','text','improve','rating','exam','name','roll','phone','device','ua','at','status','ref'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 1000
        && request.resource.data.type is string && request.resource.data.type.size() <= 20
        && request.resource.data.improve is list && request.resource.data.improve.size() <= 10
        && request.resource.data.status == 'new';
    }
  }
}
